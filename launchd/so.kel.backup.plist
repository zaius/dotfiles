<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>so.kel.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/zaius/.dotfiles/bin/backup</string>
  </array>
  <!-- Daily at 03:30; if the machine is asleep, launchd runs it on next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/zaius/Library/Logs/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zaius/Library/Logs/backup.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
