Include ~/.orbstack/ssh/config

# Reminder - this stops ssh tab completion from working
# HashKnownHosts yes

Host *
  # IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  AddKeysToAgent yes
  UseKeychain yes
  ForwardAgent yes
  ServerAliveInterval 240
  ServerAliveCountMax 30
  # 2023 03 06 - setting to no to avoid timeouts when laptop is asleep
  TCPKeepAlive no

Host vpn
  HostName 107.178.216.174
  User beyond

Host *.bnd
  ProxyCommand ssh vpn -W `echo %h |sed 's|\.bnd||g'`:%p
  User beyond
  ForwardAgent yes

Host 162.243.146.98
  User root
  IdentityFile "~/Dropbox\ (Personal)/Keys/ssh/digital_ocean.id_ecdsa"

Host 10.0.0.3
  User root
Host 10.0.0.1
  User root
Host 10.10.0.2
  User root
  PubkeyAuthentication no
  PreferredAuthentications password

Host homebridge.local
  User pi
  UserKnownHostsFile=/dev/null
  StrictHostKeyChecking no

Host celery-vm-staging
  User pd_azure_user

Host celery-vm-prod
  User pd_azure_user

Host scm-vm-staging
  User pd_azure_user

# PrettyData VMs resolve via MagicDNS on the catla-torino tailnet. Off it, go
# straight to their public IPs.
Match originalhost celery-vm-staging !exec "~/.dotfiles/bin/on-tailnet catla-torino.ts.net"
  HostName 20.106.208.242
Match originalhost celery-vm-prod !exec "~/.dotfiles/bin/on-tailnet catla-torino.ts.net"
  HostName 20.42.99.169
Match originalhost scm-vm-staging !exec "~/.dotfiles/bin/on-tailnet catla-torino.ts.net"
  HostName 68.154.49.131

Host *.catla-torino.ts.net
  User pd_azure_user

Host *.kestrel
  User kestrel
